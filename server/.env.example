# ===== 数据库 =====
# 默认 SQLite 文件库；安装 PostgreSQL 后改为：
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/newpra
DATABASE_URL=sqlite:///./newpra.db

# ===== 凭证加密（首次启动自动生成，勿外泄） =====
PLATFORM_FERNET_KEY=

# ===== GLM 语义化（可选，不配置自动降级规则命名） =====
ZHIPUAI_API_KEY=
ZHIPUAI_MODEL=glm-4.6

# ===== 邮件通知（可选，不配置则跳过发送） =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
